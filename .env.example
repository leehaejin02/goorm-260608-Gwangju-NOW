# 공공데이터포털 > 마이페이지 > 데이터활용 > Open API > 인증키 발급현황
# "일반 인증키" (Decoding 또는 Encoding) 전체 복사
# API: 한국관광공사_국문 관광정보 서비스_GW
# https://www.data.go.kr/data/15101578/openapi.do
VITE_PUBLIC_DATA_API_KEY=발급받은_키_입력

# 카카오 개발자센터 JavaScript 키 (지도용)
# https://developers.kakao.com/ > 내 애플리케이션 > 앱 키 > JavaScript 키
VITE_KAKAO_MAP_KEY=발급받은_앱키_입력

# Google Cloud Console > YouTube Data API v3
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YOUTUBE_API_KEY=발급받은_유튜브_API_키

# ── 카카오 로그인 (프론트) ──
# REST API 키 → Kakao Developers > 앱 키 > REST API 키
# Redirect URI 등록: http://localhost:5173/callback
VITE_KAKAO_CLIENT_ID=발급받은_REST_API_키

# ── 카카오 로그인 (로컬 서버 전용, VITE_ 접두사 없음) ──
# REST API 키 — 로그인 + 카카오 로컬(맛집) API 프록시에 사용
KAKAO_CLIENT_SECRET=발급받은_시크릿_키
KAKAO_REST_API_KEY=발급받은_REST_API_키
KAKAO_REDIRECT_URI=http://localhost:5173/callback

# ── Google 로그인 (프론트) ──
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI: http://localhost:5173/callback/google
VITE_GOOGLE_CLIENT_ID=발급받은_클라이언트_ID

# ── Google 로그인 (로컬 서버 전용, VITE_ 접두사 없음) ──
GOOGLE_CLIENT_SECRET=발급받은_클라이언트_시크릿
GOOGLE_REDIRECT_URI=http://localhost:5173/callback/google

# ── AI 요약 (로컬 서버 전용, VITE_ 접두사 없음) ──
# 배포 시 Vercel 대시보드 Environment Variables에만 설정
OPENAI_API_KEY=sk-발급받은_키_입력

# ── Vercel 배포 시 대시보드에 추가 ──
# OPENAI_API_KEY=sk-...
# KAKAO_CLIENT_SECRET=발급받은_시크릿_키
# KAKAO_REST_API_KEY=발급받은_REST_API_키
# GOOGLE_CLIENT_SECRET=발급받은_클라이언트_시크릿
# GOOGLE_CLIENT_ID=발급받은_클라이언트_ID (VITE_GOOGLE_CLIENT_ID와 동일)
